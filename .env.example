# Database Settings
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=codesense
POSTGRES_PORT=5432

# Application Settings
APP_NAME=CodeSense
APP_ENV=development
API_V1_STR=/api/v1
SECRET_KEY=supersecretkeyreplaceinproduction

# Redis / Cache Settings (Phase 2)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=
CACHE_TTL_SECONDS=300
ENABLE_REDIS=true

# Celery / Worker Settings
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
ENABLE_WORKER=true
WORKER_CONCURRENCY=2

# Observability Settings
ENABLE_METRICS=true
ENABLE_TRACING=true
OTEL_EXPORTER_OTLP_ENDPOINT=

# AI Settings (Optional for MVP)
OPENROUTER_API_KEY=
LLM_MODEL=google/antigravity-gemini-3.5-flash
AI_GATEWAY_URL=
